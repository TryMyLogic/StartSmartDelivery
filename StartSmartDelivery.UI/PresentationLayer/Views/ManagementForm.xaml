<Window x:Class="StartSmartDelivery.UI.ManagementForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StartSmartDelivery.UI" xmlns:comp="clr-namespace:StartSmartDelivery.UI.PresentationLayer.Views"
        mc:Ignorable="d"
        Title="ManagementForm" Height="600" Width="1000">
    <DockPanel Background="LightGray">
        <Menu Grid.Row="0"  DockPanel.Dock="Top" Focusable="False" FontSize="18">
            <MenuItem Header="File">
                <MenuItem Header="Settings"/>
                <Separator/>
                <MenuItem Header="Exit"/>
            </MenuItem>
        </Menu>
        <TabControl>
            <TabItem Header="Orders">
                <DockPanel Background="White">
                    <comp:ManagementTopBar DockPanel.Dock="Top" />
                    <comp:ManagementBottomBar Margin="0,5,0,0" DockPanel.Dock="Bottom"/>
                    <DataGrid AutoGenerateColumns="True"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Drivers">
                <DockPanel Background="White">
                    <comp:ManagementTopBar DockPanel.Dock="Top" />
                    <comp:ManagementBottomBar Margin="0,5,0,0" DockPanel.Dock="Bottom"/>
                    <DataGrid AutoGenerateColumns="True"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Vehicles">
                <DockPanel Background="White">
                    <comp:ManagementTopBar DockPanel.Dock="Top" />
                    <comp:ManagementBottomBar Margin="0,5,0,0" DockPanel.Dock="Bottom"/>
                    <DataGrid AutoGenerateColumns="True"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
